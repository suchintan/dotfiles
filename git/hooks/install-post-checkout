ROOT_NAME = ".skyvern-worktree-hooks"
LOCK_NAME = ".skyvern-worktree-hooks.lock"
RUNTIME_NAME = "post-checkout"
SETUP_NAME = "setup.sh"
HELPER_NAME = "worktree_storage.py"
VERSION_NAME = "version"
